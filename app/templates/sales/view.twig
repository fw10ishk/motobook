{% extends 'layouts/app.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/css/print-sale.css" media="print" />
{% endblock %}

{% block title %}
    Sale Details
{% endblock %}

{% block content %}
    <div class="page">
        {% include 'common/header.twig' with {
            title: 'Sale Details',
            button: false,
            button_url: '#',
            button_text: 'Edit Sale',
            button_icon: 'square-pen',
            back_button: true,
            back_url: url_for('sales.index')
        } %}
        <div class="page-content">
            <div class="view-inquiry">
                <div class="inquiry-header">
                    <div class="inquiry-title">
                        <h2>Sale #SAL-{{ sale.id }}</h2>
                        <p>
                            Sale Happened on {{ sale.sale_date|date('d M, Y') }}
                        </p>
                    </div>
                    {% if sale.sale_type == 'full' %}
                        <div class="status success">
                            {{ sale.sale_type|capitalize }}
                        </div>
                    {% else %}
                        <div class="status accent">
                            {{ sale.sale_type|capitalize }}
                        </div>
                    {% endif %}
                </div>
                <div class="inquiry-row">
                    {% if sale.car_type == 'new' %}
                        <div class="inquiry-column">
                            <h4>Customer Information</h4>
                            <div class="inquiry-data">
                                <div class="inquiry-details">
                                    <i data-lucide="user"></i>
                                    <p>
                                        {{ sale.buyer_name }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="phone"></i>
                                    <p>
                                        {{ selected_car.customer_phone }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="inquiry-column">
                            <h4>Customer Information</h4>
                            <div class="inquiry-data">
                                <div class="inquiry-details">
                                    <i data-lucide="user"></i>
                                    <p>
                                        {{ sale.buyer_name }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="phone"></i>
                                    <p>
                                        {{ sale.old_car_buyer.contact }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="mail"></i>
                                    <p>
                                        {{ sale.old_car_buyer.email }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="map-pin"></i>
                                    <p>
                                        {{ sale.old_car_buyer.address_line_1 }},
                                        {{ sale.old_car_buyer.address_line_2 }},
                                        {{ sale.old_car_buyer.city_name }},
                                        {{ sale.old_car_buyer.pincode }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                    <div class="inquiry-column">
                        <h4>Vehicle Details</h4>
                        <div class="inquiry-data">
                            <div class="inquiry-details">
                                <i data-lucide="user"></i>
                                <p>
                                    <strong>Dealer:</strong>
                                    {{ selected_car.dealer_name }}
                                </p>
                            </div>
                            <div class="inquiry-details">
                                <i data-lucide="car"></i>
                                <p>
                                    <strong>Manufacture:</strong>
                                    {{ selected_car.manufacturer_name }}
                                </p>
                            </div>
                            <div class="inquiry-details">
                                <i data-lucide="car"></i>
                                <p>
                                    <strong>Model:</strong>
                                    {{ selected_car.model_name }}
                                </p>
                            </div>
                            <div class="inquiry-details">
                                <i data-lucide="palette"></i>
                                <p>
                                    <strong>Color:</strong>
                                    {{ selected_car.color }}
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                {% if sale.car_type == 'old' %}
                    <div class="inquiry-row">
                        <div class="inquiry-column">
                            <h4>Buyer Documents</h4>
                            <div class="inquiry-data">
                                <div class="inquiry-details">
                                    <i data-lucide="credit-card"></i>
                                    <a
                                        href="/uploads/documents/{{ sale.old_car_buyer.pan_card }}"
                                        target="_blank"
                                    >
                                        PAN Card
                                    </a>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="contact"></i>
                                    <a
                                        href="/uploads/documents/{{ sale.old_car_buyer.aadhar_card }}"
                                        target="_blank"
                                    >
                                        Aadhar Card
                                    </a>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="id-card"></i>
                                    <a
                                        href="/uploads/documents/{{ sale.old_car_buyer.driving_license }}"
                                        target="_blank"
                                    >
                                        Driving License
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
                {% if selected_car.ex_showroom_price is defined %}
                    <div class="inquiry-row">
                        <div class="inquiry-column">
                            <h4>Customer Price Breakdown</h4>
                            <div class="inquiry-data">
                                <div class="inquiry-details">
                                    <i data-lucide="home"></i>
                                    <p>
                                        <strong>Ex-Showroom Price:</strong> ₹{{
                                            selected_car.ex_showroom_price|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="car"></i>
                                    <p>
                                        <strong>RTO Tax:</strong> ₹{{
                                            selected_car.rto_tax|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="umbrella"></i>
                                    <p>
                                        <strong>Insurance:</strong> ₹{{
                                            selected_car.insurance|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="file-plus"></i>
                                    <p>
                                        <strong>AMC/GMC Tax:</strong> ₹{{
                                            selected_car.amc_gmc_tax|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="shield"></i>
                                    <p>
                                        <strong>Extended Warranty:</strong> ₹{{
                                            selected_car.ext_warranty|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="box"></i>
                                    <p>
                                        <strong>Accessories:</strong> ₹{{
                                            selected_car.accessories|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="gift"></i>
                                    <p>
                                        <strong>MOTOBOOK Accessories:</strong>
                                        ₹{{
                                            selected_car.krunal_accessories|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="tag"></i>
                                    <p>
                                        <strong>Fast Tag:</strong> ₹{{
                                            selected_car.fast_tag|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="percent"></i>
                                    <p>
                                        <strong>TCS:</strong> ₹{{
                                            selected_car.tcs|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="credit-card"></i>
                                    <p>
                                        <strong>Loyalty Card:</strong> ₹{{
                                            selected_car.loyalty_card|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="credit-card"></i>
                                    <p>
                                        <strong>Driver Price:</strong> ₹{{
                                            selected_car.driver_price|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="calculator"></i>
                                    <p>
                                        <strong>Total On-Road Price:</strong> ₹{{
                                            selected_car.total_on_road|number_format
                                        }}
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="inquiry-column">
                            <h4>Customer Discount Breakdown</h4>
                            <div class="inquiry-data">
                                <div class="inquiry-details">
                                    <i data-lucide="thumbs-up"></i>
                                    <p>
                                        <strong>Consumer Offer:</strong> ₹{{
                                            selected_car.consumer_offer|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="users"></i>
                                    <p>
                                        <strong>Corporate Discount:</strong>
                                        ₹{{
                                            selected_car.corporate_discount|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="minus-circle"></i>
                                    <p>
                                        <strong>Other Discount:</strong> ₹{{
                                            selected_car.other_discount|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="dollar-sign"></i>
                                    <p>
                                        <strong>Net On-Road Price:</strong> ₹{{
                                            selected_car.net_on_road|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="hand-helping"></i>
                                    <p>
                                        <strong>Disbursement:</strong> ₹{{
                                            selected_car.disbursement|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="wallet"></i>
                                    <p>
                                        <strong>Down Payment:</strong> ₹{{
                                            selected_car.down_payment|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="receipt-indian-rupee"></i>
                                    <p>
                                        <strong>Net Short Payment:</strong> ₹{{
                                            selected_car.net_short_payment|number_format
                                        }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    {% set final_price = selected_car.current_price %}
                {% endif %}
                {% if selected_car.extra_charges is defined %}
                    <div class="inquiry-row">
                        <div class="inquiry-column">
                            <h4>Pricing Breakdown</h4>
                            <div class="inquiry-data">
                                {% for charge in selected_car.extra_charges %}
                                    {% set final_price = final_price
                                        + charge.amount
                                    %}
                                    <div class="inquiry-details">
                                        <i data-lucide="plus-circle"></i>
                                        <p>
                                            <strong>
                                                {{ charge.description }}:
                                            </strong>
                                            ₹{{ charge.amount|number_format }}
                                        </p>
                                    </div>
                                {% endfor %}
                                <div class="inquiry-details">
                                    <i data-lucide="shopping-cart"></i>
                                    <p>
                                        <strong>Total Price:</strong>
                                        ₹{{ final_price|number_format }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}

                {% if sale.car_type == 'new' %}
                    <div class="inquiry-row">
                        <div class="inquiry-column">
                            <h4>Dealer Price Breakdown</h4>
                            <div class="inquiry-data">
                                <div class="inquiry-details">
                                    <i data-lucide="home"></i>
                                    <p>
                                        <strong>Ex-Showroom Price:</strong> ₹{{
                                            selected_car.dealer_ex_showroom_price|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="car"></i>
                                    <p>
                                        <strong>RTO Tax:</strong> ₹{{
                                            selected_car.dealer_rto_tax|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="umbrella"></i>
                                    <p>
                                        <strong>Insurance:</strong> ₹{{
                                            selected_car.dealer_insurance|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="file-plus"></i>
                                    <p>
                                        <strong>AMC/GMC Tax:</strong> ₹{{
                                            selected_car.dealer_amc_gmc_tax|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="shield"></i>
                                    <p>
                                        <strong>Extended Warranty:</strong> ₹{{
                                            selected_car.dealer_ext_warranty|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="box"></i>
                                    <p>
                                        <strong>Accessories:</strong> ₹{{
                                            selected_car.dealer_accessories|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="gift"></i>
                                    <p>
                                        <strong>MOTOBOOK Accessories:</strong>
                                        ₹{{
                                            selected_car.dealer_krunal_accessories|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="tag"></i>
                                    <p>
                                        <strong>Fast Tag:</strong> ₹{{
                                            selected_car.dealer_fast_tag|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="percent"></i>
                                    <p>
                                        <strong>TCS:</strong> ₹{{
                                            selected_car.dealer_tcs|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="credit-card"></i>
                                    <p>
                                        <strong>Loyalty Card:</strong> ₹{{
                                            selected_car.dealer_loyalty_card|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="credit-card"></i>
                                    <p>
                                        <strong>Driver Price:</strong> ₹{{
                                            selected_car.dealer_driver_price|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="calculator"></i>
                                    <p>
                                        <strong>Total On-Road Price:</strong> ₹{{
                                            selected_car.dealer_total_on_road|number_format
                                        }}
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="inquiry-column">
                            <h4>Dealer Discount Breakdown</h4>
                            <div class="inquiry-data">
                                <div class="inquiry-details">
                                    <i data-lucide="thumbs-up"></i>
                                    <p>
                                        <strong>Consumer Offer:</strong> ₹{{
                                            selected_car.dealer_consumer_offer|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="users"></i>
                                    <p>
                                        <strong>Corporate Discount:</strong>
                                        ₹{{
                                            selected_car.dealer_corporate_discount|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="minus-circle"></i>
                                    <p>
                                        <strong>Other Discount:</strong> ₹{{
                                            selected_car.dealer_other_discount|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="dollar-sign"></i>
                                    <p>
                                        <strong>Net On-Road Price:</strong> ₹{{
                                            selected_car.dealer_net_on_road|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="hand-helping"></i>
                                    <p>
                                        <strong>Disbursement:</strong> ₹{{
                                            selected_car.dealer_disbursement|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="wallet"></i>
                                    <p>
                                        <strong>Down Payment:</strong> ₹{{
                                            selected_car.dealer_down_payment|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="receipt-indian-rupee"></i>
                                    <p>
                                        <strong>Net Short Payment:</strong> ₹{{
                                            selected_car.dealer_net_short_payment|number_format
                                        }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}

                {# <div class="inquiry-actions">
                    <button class="btn btn-primary">
                        <i data-lucide="printer"></i>
                        Print Details
                    </button>
                </div> #}
            </div>
        </div>
    </div>
    <script src="/js/print-sale.js"></script>
{% endblock %}
