                {% if sale.sale_type == 'full' %}
                    <div class="inquiry-row">
                        <div class="inquiry-column">
                            <h4>Customer Payment Details</h4>
                            <div class="inquiry-data">
                                <div class="inquiry-details">
                                    <i data-lucide="banknote"></i>
                                    <p>
                                        <strong>Total Amount:</strong>
                                        ₹{{
                                            sale.full_payment.total_amount|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="check-circle"></i>
                                    <p>
                                        <strong>Amount Paid:</strong>
                                        ₹{{
                                            sale.full_payment.amount_paid|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="circle-dollar-sign"></i>
                                    <p>
                                        <strong>Remaining Amount:</strong>
                                        ₹{{
                                            sale.full_payment.remaining_amount|number_format
                                        }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="inquiry-row">
                        <div class="inquiry-column">
                            <div class="loan-schedule-header">
                                <h4>Customer Payment History</h4>
                                <div class="schedule-summary">
                                    <span class="status success">
                                        <i data-lucide="banknote"></i>
                                        ₹{{
                                            sale.full_payment.amount_paid|number_format
                                        }} Paid
                                    </span>
                                    <span class="status warning">
                                        <i data-lucide="circle-dollar-sign"></i>
                                        ₹{{
                                            sale.full_payment.remaining_amount|number_format
                                        }} Remaining
                                    </span>
                                </div>
                            </div>
                            <div class="inquiry-data installment-schedule">
                                <div class="inquiry-details loan-details">
                                    <div class="installment-content">
                                        <div class="installment-icon">
                                            <i data-lucide="plus-circle"></i>
                                        </div>
                                        <div class="installment-info">
                                            <form
                                                method="POST"
                                                action="{{
                                                url_for(
                                                    'sales.record-full-payment',
                                                    {
                                                        id: sale.full_payment.id,
                                                        sale_id: sale.id
                                                    }
                                                )
                                                }}"
                                                class="payment-form"
                                            >
                                                <input
                                                    type="hidden"
                                                    name="_METHOD"
                                                    value="PUT"
                                                />
                                                <div class="form-group row">
                                                    <input
                                                        type="number"
                                                        name="amount"
                                                        placeholder="Enter amount"
                                                        step="0.01"
                                                        max="{{
                                                        sale.full_payment.remaining_amount
                                                        }}"
                                                        required
                                                        class="form-control"
                                                    />
                                                    <select
                                                        name="payment_method"
                                                        required
                                                        class="form-control"
                                                    >
                                                        <option value="cash">
                                                            Cash
                                                        </option>
                                                        <option value="check">
                                                            Check
                                                        </option>
                                                        <option value="online">
                                                            Online
                                                        </option>
                                                        <option value="bank">
                                                            Bank
                                                        </option>
                                                    </select>
                                                    <input
                                                        type="date"
                                                        name="payment_date"
                                                        value="{{ 'now'|date(
                                                            'Y-m-d'
                                                        ) }}"
                                                        required
                                                        class="form-control"
                                                    />
                                                    <input
                                                        type="submit"
                                                        class="btn btn-primary"
                                                        value="Add Payment"
                                                    />
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                {% for payment in sale.full_payment.payments %}
                                    <div
                                        class="inquiry-details loan-details paid-installment"
                                    >
                                        <div class="installment-content">
                                            <div class="installment-icon">
                                                {% if
                                                    payment.payment_method
                                                        == 'cash' %}
                                                    <i data-lucide="banknote">

                                                    </i>
                                                {% elseif
                                                    payment.payment_method
                                                        == 'check' %}
                                                    <i
                                                        data-lucide="credit-card"
                                                    >

                                                    </i>
                                                {% elseif
                                                    payment.payment_method
                                                        == 'online' %}
                                                    <i data-lucide="smartphone">

                                                    </i>
                                                {% else %}
                                                    <i data-lucide="landmark">

                                                    </i>
                                                {% endif %}
                                            </div>
                                            <div class="installment-info">
                                                <div class="payment-form">
                                                    <div class="form-group row">
                                                        <input
                                                            type="number"
                                                            name="amount"
                                                            placeholder="Enter amount"
                                                            step="0.01"
                                                            value="{{
                                                            payment.amount
                                                            }}"
                                                            required
                                                            class="form-control"
                                                        />
                                                        <input
                                                            type="text"
                                                            name="payment_method"
                                                            id="payment_method"
                                                            value="{{ payment.payment_method|capitalize }}"
                                                            class="form-control"
                                                        />
                                                        <input
                                                            type="date"
                                                            name="payment_date"
                                                            value="{{ payment.payment_date|date(
                                                                'Y-m-d'
                                                            ) }}"
                                                            required
                                                            class="form-control"
                                                        />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endif %}

                {% if sale.car_type == 'new' %}
                    <div class="inquiry-row">
                        <div class="inquiry-column">
                            <h4>Dealer Price Breakdown</h4>
                            <div class="inquiry-data">
                                <div class="inquiry-details">
                                    <i data-lucide="home"></i>
                                    <p>
                                        <strong>Ex-Showroom Price:</strong> ₹{{
                                            selected_car.dealer_ex_showroom_price|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="car"></i>
                                    <p>
                                        <strong>RTO Tax:</strong> ₹{{
                                            selected_car.dealer_rto_tax|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="umbrella"></i>
                                    <p>
                                        <strong>Insurance:</strong> ₹{{
                                            selected_car.dealer_insurance|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="file-plus"></i>
                                    <p>
                                        <strong>AMC/GMC Tax:</strong> ₹{{
                                            selected_car.dealer_amc_gmc_tax|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="shield"></i>
                                    <p>
                                        <strong>Extended Warranty:</strong> ₹{{
                                            selected_car.dealer_ext_warranty|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="box"></i>
                                    <p>
                                        <strong>Accessories:</strong> ₹{{
                                            selected_car.dealer_accessories|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="gift"></i>
                                    <p>
                                        <strong>MOTOBOOK Accessories:</strong>
                                        ₹{{
                                            selected_car.dealer_krunal_accessories|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="tag"></i>
                                    <p>
                                        <strong>Fast Tag:</strong> ₹{{
                                            selected_car.dealer_fast_tag|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="percent"></i>
                                    <p>
                                        <strong>TCS:</strong> ₹{{
                                            selected_car.dealer_tcs|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="credit-card"></i>
                                    <p>
                                        <strong>Loyalty Card:</strong> ₹{{
                                            selected_car.dealer_loyalty_card|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="credit-card"></i>
                                    <p>
                                        <strong>Driver Price:</strong> ₹{{
                                            selected_car.dealer_driver_price|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="calculator"></i>
                                    <p>
                                        <strong>Total On-Road Price:</strong> ₹{{
                                            selected_car.dealer_total_on_road|number_format
                                        }}
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="inquiry-column">
                            <h4>Dealer Discount Breakdown</h4>
                            <div class="inquiry-data">
                                <div class="inquiry-details">
                                    <i data-lucide="thumbs-up"></i>
                                    <p>
                                        <strong>Consumer Offer:</strong> ₹{{
                                            selected_car.dealer_consumer_offer|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="users"></i>
                                    <p>
                                        <strong>Corporate Discount:</strong>
                                        ₹{{
                                            selected_car.dealer_corporate_discount|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="minus-circle"></i>
                                    <p>
                                        <strong>Other Discount:</strong> ₹{{
                                            selected_car.dealer_other_discount|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="dollar-sign"></i>
                                    <p>
                                        <strong>Net On-Road Price:</strong> ₹{{
                                            selected_car.dealer_net_on_road|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="hand-helping"></i>
                                    <p>
                                        <strong>Disbursement:</strong> ₹{{
                                            selected_car.dealer_disbursement|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="wallet"></i>
                                    <p>
                                        <strong>Down Payment:</strong> ₹{{
                                            selected_car.dealer_down_payment|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="receipt-indian-rupee"></i>
                                    <p>
                                        <strong>Net Short Payment:</strong> ₹{{
                                            selected_car.dealer_net_short_payment|number_format
                                        }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="inquiry-row">
                        <div class="inquiry-column">
                            <h4>Dealer Payment Details</h4>
                            <div class="inquiry-data">
                                <div class="inquiry-details">
                                    <i data-lucide="banknote"></i>
                                    <p>
                                        <strong>Total Amount:</strong>
                                        ₹{{
                                            sale.dealer_full_payment.total_amount|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="check-circle"></i>
                                    <p>
                                        <strong>Amount Paid:</strong>
                                        ₹{{
                                            sale.dealer_full_payment.amount_paid|number_format
                                        }}
                                    </p>
                                </div>
                                <div class="inquiry-details">
                                    <i data-lucide="circle-dollar-sign"></i>
                                    <p>
                                        <strong>Remaining Amount:</strong>
                                        ₹{{
                                            sale.dealer_full_payment.remaining_amount|number_format
                                        }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="inquiry-row">
                        <div class="inquiry-column">
                            <div class="loan-schedule-header">
                                <h4>Dealer Payment History</h4>
                                <div class="schedule-summary">
                                    <span class="status success">
                                        <i data-lucide="banknote"></i>
                                        ₹{{
                                            sale.dealer_full_payment.amount_paid|number_format
                                        }} Paid
                                    </span>
                                    <span class="status warning">
                                        <i data-lucide="circle-dollar-sign"></i>
                                        ₹{{
                                            sale.dealer_full_payment.remaining_amount|number_format
                                        }} Remaining
                                    </span>
                                </div>
                            </div>
                            <div class="inquiry-data installment-schedule">
                                <div class="inquiry-details loan-details">
                                    <div class="installment-content">
                                        <div class="installment-icon">
                                            <i data-lucide="plus-circle"></i>
                                        </div>
                                        <div class="installment-info">
                                            <form
                                                method="POST"
                                                action="{{
                                                url_for(
                                                    'sales.record-dealer-full-payment',
                                                    {
                                                        id: sale.dealer_full_payment.id,
                                                        sale_id: sale.id
                                                    }
                                                )
                                                }}"
                                                class="payment-form"
                                            >
                                                <input
                                                    type="hidden"
                                                    name="_METHOD"
                                                    value="PUT"
                                                />
                                                <div class="form-group row">
                                                    <input
                                                        type="number"
                                                        name="dealer_amount"
                                                        placeholder="Enter amount"
                                                        step="0.01"
                                                        max="{{
                                                        sale.dealer_full_payment.remaining_amount
                                                        }}"
                                                        required
                                                        class="form-control"
                                                    />
                                                    <select
                                                        name="dealer_payment_method"
                                                        required
                                                        class="form-control"
                                                    >
                                                        <option value="cash">
                                                            Cash
                                                        </option>
                                                        <option value="check">
                                                            Check
                                                        </option>
                                                        <option value="online">
                                                            Online
                                                        </option>
                                                        <option value="bank">
                                                            Bank
                                                        </option>
                                                    </select>
                                                    <input
                                                        type="date"
                                                        name="dealer_payment_date"
                                                        value="{{ 'now'|date(
                                                            'Y-m-d'
                                                        ) }}"
                                                        required
                                                        class="form-control"
                                                    />
                                                    <input
                                                        type="submit"
                                                        class="btn btn-primary"
                                                        value="Add Payment"
                                                    />
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                {% for payment in sale.dealer_full_payment.payments %}
                                    <div
                                        class="inquiry-details loan-details paid-installment"
                                    >
                                        <div class="installment-content">
                                            <div class="installment-icon">
                                                {% if
                                                    payment.payment_method
                                                        == 'cash' %}
                                                    <i data-lucide="banknote">

                                                    </i>
                                                {% elseif
                                                    payment.payment_method
                                                        == 'check' %}
                                                    <i
                                                        data-lucide="credit-card"
                                                    >

                                                    </i>
                                                {% elseif
                                                    payment.payment_method
                                                        == 'online' %}
                                                    <i data-lucide="smartphone">

                                                    </i>
                                                {% else %}
                                                    <i data-lucide="landmark">

                                                    </i>
                                                {% endif %}
                                            </div>
                                            <div class="installment-info">
                                                <div class="payment-form">
                                                    <div class="form-group row">
                                                        <input
                                                            type="number"
                                                            name="amount"
                                                            placeholder="Enter amount"
                                                            step="0.01"
                                                            value="{{
                                                            payment.amount
                                                            }}"
                                                            required
                                                            class="form-control"
                                                        />
                                                        <input
                                                            type="text"
                                                            name="payment_method"
                                                            id="payment_method"
                                                            value="{{ payment.payment_method|capitalize }}"
                                                            class="form-control"
                                                        />
                                                        <input
                                                            type="date"
                                                            name="payment_date"
                                                            value="{{ payment.payment_date|date(
                                                                'Y-m-d'
                                                            ) }}"
                                                            required
                                                            class="form-control"
                                                        />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endif %}

                {# <div class="inquiry-actions">
                    <button class="btn btn-primary">
                        <i data-lucide="printer"></i>
                        Print Details
                    </button>
                </div> #}
            </div>
        </div>
    </div>
    <script src="/js/print-sale.js"></script>
{% endblock %}
